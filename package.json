{
  "name": "prediktive-qa-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "DuckDuckGo QA assessment - Playwright + TypeScript (Web + API)",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=web --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "codegen": "playwright codegen https://start.duckduckgo.com/",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0"
  }
}
